{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {"type": "host", "value": "www.thealanashow.com"}
      ],
      "destination": "https://thealanashow.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/episodes/:slug",
      "destination": "/episodes/detail.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
