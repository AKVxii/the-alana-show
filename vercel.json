{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/alana-portrait-cutout-v2.png",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31556952, immutable"}
      ]
    },
    {
      "source": "/assets/alana-portrait-cutout-v3.webp",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31556952, immutable"}
      ]
    },
    {
      "source": "/assets/broadcast-reach-south-florida-v2.webp",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31556952, immutable"}
      ]
    },
    {
